# UNIventory environment example (owner: Jesher). Copy to .env for local
# development. Never commit real secrets (NFR-10). Real environment variables
# override this file.

# --- Core ---
DJANGO_DEBUG=true
# Required when DEBUG is false. Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# Hosted pilot behind the TLS proxy: keep the default (true). Local HTTP only: false.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000

# --- Database: PostgreSQL in hosted environments; SQLite for local work ---
# DATABASE_URL=postgres://univentory:CHANGE_ME@localhost:5432/univentory
DATABASE_URL=sqlite:///db.sqlite3

# --- KU SSO (OIDC, authorisation code + PKCE). Values come from KU IT. ---
KU_OIDC_ISSUER=
KU_OIDC_CLIENT_ID=
KU_OIDC_CLIENT_SECRET=
KU_OIDC_REDIRECT_URI=https://univentory.example/identity/sign-in/callback/
KU_OIDC_SCOPES=openid profile email
KU_OIDC_POST_LOGOUT_REDIRECT=https://univentory.example/identity/signed-out/

# Development sign-in test adapter. Ignored unless DJANGO_DEBUG=true.
UNIVENTORY_DEV_LOGIN=true

# --- Protected evidence files and backups ---
UNIVENTORY_PROTECTED_MEDIA_ROOT=protected_media
UNIVENTORY_BACKUP_DIR=backups
# Generate: python manage.py backup_create --generate-key . Store a copy off-host.
UNIVENTORY_BACKUP_KEY=

# --- Contract adapters (plan Section 9). Owners switch these to the real
# implementations; until then the labelled test adapters are used. ---
# UNIVENTORY_RELEASE_APPROVALS_ADAPTER=workflow.adapters.ReleaseApprovals
# UNIVENTORY_AUDIT_ADAPTER=audit.services.AuditService
